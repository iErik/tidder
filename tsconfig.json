{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "experimentalDecorators": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strict": false,
    "paths": {
      "core/*": ["./app/core/*"],
      "utils/*": ["./app/utils/*"],
      "pages/*": ["./app/pages/*"],
      "config/*": ["./app/config/*"],
      "layouts/*": ["./app/layouts/*"],
      "services/*": ["./app/services/*"],
      "components/*": ["./app/components/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": true
  }
}
