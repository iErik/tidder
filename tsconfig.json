{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "paths": {
      "api/*": ["./app/api/*"],
      "core/*": ["./app/core/*"],
      "hooks/*": ["./app/hooks/*"],
      "utils/*": ["./app/utils/*"],
      "pages/*": ["./app/pages/*"],
      "config/*": ["./app/config/*"],
      "layouts/*": ["./app/layouts/*"],
      "components/*": ["./app/components/*"]
    }
  },
  "include": ["app", "vite.config.mts"]
}
