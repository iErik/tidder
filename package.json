{
  "name": "tidder",
  "description": "An multi-platform reddit client built with web technologies",
  "repository": "iErik/tidder",
  "productName": "Tidder",
  "version": "1.0.0-beta.17",
  "license": "GPL-2.0-only",
  "author": {
    "name": "Erik Isidore",
    "email": "ericssonico@protonmail.ch",
    "url": "https://github.com/ierik"
  },
  "main": "electron/main.js",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "themes": "node scripts/generate-theme-scss.mjs",
    "dev": "pnpm run themes && concurrently -k -n vite,electron \"vite\" \"wait-on http-get://localhost:4200 && cross-env TIDDER_DEV_URL=http://localhost:4200 electron .\"",
    "build": "pnpm run themes && tsc --noEmit && vite build",
    "test": "pnpm run themes && vitest run",
    "test:watch": "pnpm run themes && vitest",
    "test:coverage": "pnpm run themes && vitest run --coverage",
    "lint": "eslint . && stylelint \"**/*.scss\"",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.scss\"",
    "start": "pnpm run build && electron .",
    "build:pack": "pnpm run build && electron-builder",
    "build:pack:multi": "pnpm run build && electron-builder -mlw --x64 --arm64",
    "build:pack:mac": "pnpm run build && electron-builder --mac --x64 --arm64",
    "build:pack:win": "pnpm run build && electron-builder --win --x64",
    "build:pack:linux": "pnpm run build && electron-builder --linux --x64",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "build": {
    "productName": "Tidder",
    "appId": "org.isidore.Tidder",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "electron/**",
      "!electron/test/**",
      "!electron/**/*.test.js",
      "dist/renderer/**",
      "app/config/authConfig.json",
      "app/config/settings.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": "zip",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Feed",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "foundation-sites": "^6.9.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-scss": "^4.0.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.4",
    "wait-on": "^9.1.0"
  }
}
