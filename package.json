{
  "name": "tidder",
  "description": "An multi-platform reddit client built with web technologies",
  "repository": "iErik/tidder",
  "productName": "Tidder",
  "version": "1.0.0-beta.2",
  "license": "GPL-2.0-only",
  "author": {
    "name": "Erik Isidore",
    "email": "ericssonico@protonmail.ch",
    "url": "https://github.com/ierik"
  },
  "main": "electron/main.js",
  "scripts": {
    "themes": "node scripts/generate-theme-scss.mjs",
    "dev": "npm run themes && concurrently -k -n ng,electron \"ng serve --port 4200\" \"wait-on http-get://localhost:4200 && cross-env TIDDER_DEV_URL=http://localhost:4200 electron .\"",
    "build": "npm run themes && ng build",
    "start": "npm run build && electron .",
    "build:pack": "npm run build && electron-builder",
    "build:pack:multi": "npm run build && electron-builder -mlw --x64 --arm64",
    "build:pack:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "build:pack:win": "npm run build && electron-builder --win --x64",
    "build:pack:linux": "npm run build && electron-builder --linux --x64"
  },
  "build": {
    "productName": "Tidder",
    "artifactName": "${productName} Beta-${arch}.${ext}",
    "appId": "org.isidore.Tidder",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/renderer/**",
      "app/config/authConfig.json",
      "app/config/settings.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": "zip",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "category": "Feed",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@types/underscore": "^1.13.0",
    "angular-oauth2-oidc": "^22.0.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "foundation-sites": "^6.9.0",
    "moment": "^2.31.0",
    "ngx-infinite-scroll": "^22.0.0",
    "ngx-moment": "^6.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.0",
    "underscore": "^1.13.8",
    "wait-on": "^9.1.0",
    "zone.js": "^0.16.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "electron-winstaller": false
  }
}
